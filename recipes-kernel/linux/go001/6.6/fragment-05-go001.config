# WWAN interfaces
CONFIG_USB_USBNET=m

CONFIG_USB_NET_QMI_WWAN=m
CONFIG_QCOM_QMI_HELPERS=m

CONFIG_MHI_WWAN_MBIM=m

CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_CDC_SUBSET_ENABLE=m
CONFIG_USB_NET_CDC_SUBSET=m
CONFIG_USB_CDC_PHONET=m
CONFIG_USB_CDC_COMPOSITE=m
CONFIG_USB_WDM=m

# Support USB serial interfaces
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_OPTION=m

# Supports WLAN Realtek RTW88XX series
CONFIG_WLAN=m
CONFIG_WLAN_VENDOR_REALTEK=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m

CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUSB=m
CONFIG_BT_BREDR=m
CONFIG_BT_LE=m
CONFIG_BT_RTL=m
CONFIG_BT_HCIBTUSB_RTL=m

# Debug DRM
CONFIG_DRM_USE_DYNAMIC_DEBUG=y
CONFIG_DRM_SII902X=m
# CONFIG_DRM_STM_DSI is not set
# CONFIG_DRM_STM_LVDS is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_ETNAVIV_THERMAL is not set
CONFIG_DRM_STM=m

# Backlight configuration
# CONFIG_BACKLIGHT_AS3711 is not set
# CONFIG_BACKLIGHT_GPIO is not set
# CONFIG_LEDS_TRIGGER_BACKLIGHT is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_BACKLIGHT_PWM=m

# Vibration motor
CONFIG_INPUT_PWM_VIBRA=m

# Ambient Light Sensor.
CONFIG_OPT3001=m

# Pressure, temperature and humidity iio sensors
CONFIG_BMP280=m
CONFIG_BMP280_I2C=m

# Motion tracking sensors
CONFIG_INV_MPU6050_IIO=m
CONFIG_INV_MPU6050_I2C=m

# SPI Ethernet card
CONFIG_NET_VENDOR_WIZNET=y
CONFIG_WIZNET_W5100=m
CONFIG_WIZNET_W5100_SPI=m

# IIO subsystem
CONFIG_IIO_TRIGGERED_EVENT=y
